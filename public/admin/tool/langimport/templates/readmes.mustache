{{!
    @template tool_langimport/readmes

    Notes supplied by installed language packs.

    Context variables required for this template:
    * readmes - Notes with a language name, formatted content, and initial expanded state.

    Example context (json):
    {
        "readmes": [
            {
                "name": "English (Tengwar) (en_teng)",
                "expanded": true,
                "readme": "<p>Install the FreeMonoTengwar font before using this language pack.</p>"
            }
        ]
    }
}}
{{#readmes.0}}
    <section class="mb-4" aria-labelledby="langpacknotesheading">
        <h3 id="langpacknotesheading">{{#str}}langpacknotes, tool_langimport{{/str}}</h3>
        {{#readmes}}
            <details class="mb-3" {{#expanded}}open{{/expanded}}>
                <summary class="fw-bold aalink"><bdi>{{name}}</bdi></summary>
                <div class="mt-3" dir="auto">{{{readme}}}</div>
            </details>
        {{/readmes}}
    </section>
{{/readmes.0}}
